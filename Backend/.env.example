# Copia este archivo como .env y completa únicamente los valores de tu entorno.
# Nunca subas el archivo .env ni claves reales al repositorio.
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# True solo detrás de HTTPS. Para una demostración LAN sin certificado, usa False.
DJANGO_HTTPS=False
DJANGO_HSTS_SECONDS=0
RAG_PRELOAD_EMBEDDINGS=True

POSTGRES_DB=tecsisai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Si OPENWEBUI_TOKEN queda vacío, el sistema funciona en modo demostración.
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_TOKEN=
OPENWEBUI_MODEL=google/gemma-4-26B-A4B-it
GEMINI_API_KEY=
